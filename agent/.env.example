# 本機開發用設定（agents-cli playground / run / eval）。複製為 .env 後填入。
# Docker Compose 內的 Agent 改由專案根目錄的 .env 取得這些值。

# 模型憑證（二選一）
# A. Google AI Studio API key：https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# B. Vertex AI（需先 gcloud auth application-default login）
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Agent 使用的 Gemini 模型
AGENT_MODEL=gemini-3.8-flash

# MCP Server 位址（本機連 Docker Compose 開出來的 8010 埠）
MCP_URL=http://localhost:8010/mcp

# Agent 回覆中的系統連結網址
FRONTEND_URL=http://localhost:3000

# agents-cli eval 評分用（A 方案也需要）：refusal_or_action 這類 prompt_template 評審
# 在 Vertex AI Eval Service 上執行，需要 gcloud auth application-default login 與
# 已啟用 Vertex AI API 的 GCP 專案。Agent 本身仍使用上面的 GEMINI_API_KEY。
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
