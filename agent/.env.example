# 本機開發用設定（agents-cli playground / run / eval）。複製為 .env 後填入。
# Docker Compose 內的 Agent 改由專案根目錄的 .env 取得這些值。

# 模型憑證（二選一）
# A. Google AI Studio API key：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# B. Vertex AI（需先 gcloud auth application-default login）
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# Agent 使用的 Gemini 模型
AGENT_MODEL=gemini-3.8-flash

# MCP Server 位址（本機連 Docker Compose 開出來的 8010 埠）
MCP_URL=http://localhost:8010/mcp
